# Upstream agent services (defaults point at the deployed Fly.dev instances)
AGENT1_URL=https://adas-req-refiner.fly.dev
AGENT2_URL=https://agenticve-testing.fly.dev
AGENT3_URL=https://adas-scenarios-gen.fly.dev

# Same Postgres as the Next.js app (Prisma). Needed only for MCP resources.
DATABASE_URL=postgresql://user:pass@localhost:5432/veridian

# Gateway bind (Streamable HTTP endpoint will be /mcp)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8100
